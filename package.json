{
  "name": "agro-scale-connector",
  "version": "1.0.0",
  "description": "Servicio de captura y conexión de balanza industrial - Sobifruits",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "package-win": "electron-builder --win --x64"
  },
  "author": "Sobifruits S.A.C.",
  "license": "ISC",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^35.1.4",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "electron-store": "^8.1.0",
    "express": "^5.1.0",
    "fs-extra": "^11.2.0",
    "serialport": "^10.5.0"
  },
  "build": {
    "appId": "com.sobifruits.balanza-connector",
    "productName": "Conector de Balanza - Sobifruits",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Conector de Balanza",
      "uninstallDisplayName": "Conector de Balanza - Sobifruits",
      "artifactName": "Conector-Balanza-Setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Conector-Balanza-Portable-${version}.${ext}"
    }
  }
}
