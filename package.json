{
  "name": "weight-capture-service",
  "version": "1.0.0",
  "description": "Lightweight Electron app for capturing weights from scales and bridging to web application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "package-win": "electron-builder --win --x64",
    "rebuild": "electron-rebuild -f -w serialport"
  },
  "author": "Alchlab S.A.C",
  "license": "ISC",
  "devDependencies": {
    "electron": "^35.1.4",
    "electron-builder": "^26.0.12",
    "@electron/rebuild": "^4.2.0"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "electron-store": "^8.1.0",
    "express": "^5.1.0",
    "fs-extra": "^11.2.0",
    "serialport": "^10.5.0"
  },
  "build": {
    "appId": "com.alchlab.weight-capture",
    "productName": "Weight Capture Service",
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "node_modules/serialport/build/Release",
        "to": "app.asar.unpacked/node_modules/serialport/build/Release",
        "filter": [
          "*.node"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/serialport/build/Release"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Weight Capture Service",
      "uninstallDisplayName": "Weight Capture Service - Alchlab",
      "artifactName": "Weight-Capture-Service-Setup-${version}.exe",
      "menuCategory": "Alchlab",
      "installerIcon": "assets/logo.ico",
      "uninstallerIcon": "assets/logo.ico"
    }
  }
}
